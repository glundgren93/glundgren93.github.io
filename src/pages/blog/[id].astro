---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} - Gabriel Lundgren`} description={post.data.description}>
  <article>
    <header>
      <h1>{post.data.title}</h1>
      <time datetime={post.data.date.toISOString()}>
        {post.data.date.toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
      </time>
    </header>
    <Content />
  </article>
  <dialog class="image-viewer" aria-label="Expanded image">
    <button class="image-close" type="button" aria-label="Close expanded image">Close ×</button>
    <div class="image-stage">
      <button class="image-zoom" type="button" aria-label="Zoom to full size" aria-pressed="false">
        <img alt="" />
      </button>
    </div>
  </dialog>
</Base>

<script>
  const viewer = document.querySelector<HTMLDialogElement>(".image-viewer")!;
  const expanded = viewer.querySelector<HTMLImageElement>("img")!;
  const zoom = viewer.querySelector<HTMLButtonElement>(".image-zoom")!;
  const stage = viewer.querySelector<HTMLElement>(".image-stage")!;

  document.querySelectorAll<HTMLImageElement>("article img").forEach((image) => {
    if (image.closest("a")) return;
    const button = document.createElement("button");
    button.type = "button";
    button.className = "image-expand";
    button.setAttribute("aria-label", `Expand image: ${image.alt || "Blog image"}`);
    image.replaceWith(button);
    button.append(image);
    button.addEventListener("click", () => {
      expanded.src = image.currentSrc || image.src;
      expanded.alt = image.alt;
      zoom.setAttribute("aria-pressed", "false");
      zoom.setAttribute("aria-label", "Zoom to full size");
      viewer.showModal();
      document.documentElement.style.overflow = "hidden";
      stage.scrollTo(0, 0);
    });
  });

  zoom.addEventListener("click", () => {
    const enlarged = zoom.getAttribute("aria-pressed") !== "true";
    zoom.setAttribute("aria-pressed", String(enlarged));
    zoom.setAttribute("aria-label", enlarged ? "Fit image to screen" : "Zoom to full size");
  });
  viewer.querySelector(".image-close")!.addEventListener("click", () => viewer.close());
  viewer.addEventListener("click", (event) => {
    if (event.target === viewer || event.target === stage) viewer.close();
  });
  viewer.addEventListener("close", () => {
    document.documentElement.style.overflow = "";
  });
</script>

<style>
  article :global(.image-expand) {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  article :global(.image-expand:focus-visible) {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
  }

  .image-viewer {
    position: fixed;
    inset: 0;
    margin: auto;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    padding: 4rem 1.5rem 1.5rem;
    border: 0;
    background: transparent;
    overflow: hidden;
  }

  .image-viewer::backdrop {
    background: rgb(12 12 14 / 94%);
    backdrop-filter: blur(6px);
  }

  .image-close {
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    padding: 0.35rem 0.75rem;
    font: inherit;
    font-size: 0.8rem;
    color: #f5f5f5;
    background: rgb(255 255 255 / 8%);
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: 999px;
    cursor: pointer;
  }

  .image-stage {
    display: flex;
    width: 100%;
    height: 100%;
    overflow: auto;
  }

  .image-zoom {
    display: block;
    flex-shrink: 0;
    max-width: 100%;
    margin: auto;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .image-zoom img {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - 5.5rem);
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 12px 48px rgb(0 0 0 / 40%);
  }

  .image-zoom[aria-pressed="true"] {
    width: max-content;
    max-width: none;
    cursor: zoom-out;
  }

  .image-zoom[aria-pressed="true"] img {
    max-width: none;
    max-height: none;
  }

  article header {
    margin-bottom: 2rem;
  }

  article header h1 {
    margin-bottom: 0.25rem;
  }

</style>
